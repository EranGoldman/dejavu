# DejaVu Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================
# Backend Configuration
# ============================================

# Flask secret key (generate a secure random key for production)
SECRET_KEY=your-secret-key-here-change-in-production

# Debug mode (set to False in production)
DEBUG=True

# Database URL
# Examples:
#   SQLite: sqlite:///dejavu.db
#   PostgreSQL: postgresql://user:password@localhost/dejavu
#   MySQL: mysql://user:password@localhost/dejavu
DATABASE_URL=sqlite:///dejavu.db

# Upload folder for images
UPLOAD_FOLDER=./uploads

# ============================================
# API Configuration
# ============================================

# API key for device authentication
API_KEY=your-api-key-here

# Require API key for uploads (set to True in production)
REQUIRE_API_KEY=False

# CORS allowed origins (comma-separated)
CORS_ORIGINS=*

# ============================================
# AI/ML Configuration
# ============================================

# AI model for image tagging
AI_MODEL=clip-vit-base-patch32

# Use GPU for inference (if available)
USE_GPU=False

# ============================================
# Device Configuration
# ============================================

# Backend API URL (used by devices)
BACKEND_URL=http://localhost:5000

# Device identification
DEVICE_ID=dejavu-device-001
DEVICE_NAME=DejaVu Device

# Image queue directory for offline storage
IMAGE_QUEUE_DIR=./image_queue

# ============================================
# Optional: External Services
# ============================================

# AWS S3 (for cloud storage)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=dejavu-images
# AWS_REGION=us-east-1

# Email notifications (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Monitoring (optional)
# SENTRY_DSN=your-sentry-dsn
